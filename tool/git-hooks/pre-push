#!/bin/sh
# Local stand-in for branch protection on main (GitHub's needs a paid plan
# for private repos). Refuses, for every remote:
#   - pushing straight to main: use a branch and a pull request;
#   - deleting main;
#   - force pushes (rewriting history) to any branch.
#
# Turn it on in a checkout:   git config core.hooksPath tool/git-hooks
# One-off override:           RELAY_ALLOW_MAIN_PUSH=1 git push …   (or --no-verify)

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"

  if [ "$local_sha" = "$zero" ]; then
    if [ "$branch" = "main" ]; then
      echo "pre-push: refusing to delete main." >&2
      status=1
    fi
    continue
  fi

  if [ "$branch" = "main" ] && [ "${RELAY_ALLOW_MAIN_PUSH:-}" != "1" ]; then
    echo "pre-push: main is protected. Push a branch and open a pull request:" >&2
    echo "  git switch -c my-change && git push -u origin my-change && gh pr create" >&2
    echo "  (one-off override: RELAY_ALLOW_MAIN_PUSH=1 git push)" >&2
    status=1
    continue
  fi

  if [ "$remote_sha" != "$zero" ]; then
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "pre-push: $branch on the remote has commits you don't have. Fetch and rebase or merge first." >&2
      status=1
    elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "pre-push: refusing to force-push $branch (it would drop commits from the remote)." >&2
      status=1
    fi
  fi
done

exit $status
